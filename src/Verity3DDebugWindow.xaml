<Window x:Class="DesktopVerity.Verity3DDebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:DesktopVerity"
        mc:Ignorable="d"
        Title="Verity3DDebugWindow" Height="450" Width="800"
        d:DataContext="{ Binding ElementName=_verityWindow }">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical" Grid.Column="0">
                    <StackPanel Orientation="Vertical" Margin="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Rotate Verity (X) " HorizontalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock Text="{ Binding VerityRotationX }" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Slider Minimum="0" Maximum="360" Value="{Binding VerityRotationX, Mode=TwoWay}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Rotate Verity (Y) " HorizontalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock Text="{ Binding VerityRotationY }" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Slider Minimum="0" Maximum="360" Value="{Binding VerityRotationY, Mode=TwoWay}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Rotate Verity (Z) " HorizontalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock Text="{ Binding VerityRotationZ }" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Slider Minimum="0" Maximum="360" Value="{Binding VerityRotationZ, Mode=TwoWay}" Margin="0,5,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Vertical" Grid.Column="1">
                <StackPanel Orientation="Vertical" Margin="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Camera position (X) " HorizontalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Text="{ Binding CameraPositionX }" HorizontalAlignment="Center" />
                    </StackPanel>
                    <Slider Minimum="-1" Maximum="1.0" Value="{Binding CameraPositionX, Mode=TwoWay}" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Camera position (Y) " HorizontalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Text="{ Binding CameraPositionY }" HorizontalAlignment="Center" />
                    </StackPanel>
                    <Slider Minimum="-7" Maximum="-5" Value="{Binding CameraPositionY, Mode=TwoWay}" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Camera position (Z) " HorizontalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Text="{ Binding CameraPositionZ }" HorizontalAlignment="Center" />
                    </StackPanel>
                    <Slider Minimum="-0.1" Maximum="1.0" Value="{Binding CameraPositionZ, Mode=TwoWay}" Margin="0,5,0,0"/>
                </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Vertical" Grid.Column="2">
                    <StackPanel Orientation="Vertical" Margin="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Light position (X) " HorizontalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock Text="{ Binding LightPosition.X }" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Slider Minimum="-10" Maximum="10" Value="{Binding LightPositionX, Mode=TwoWay}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Light position (Y) " HorizontalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock Text="{ Binding LightPosition.Y }" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Slider Minimum="-10" Maximum="10" Value="{Binding LightPositionY, Mode=TwoWay}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Light position (Z) " HorizontalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock Text="{ Binding LightPosition.Z }" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Slider Minimum="-10" Maximum="10" Value="{Binding LightPositionZ, Mode=TwoWay}" Margin="0,5,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Label VerticalAlignment="Center">Verity emotion</Label>
            <ComboBox SelectedItem="0">
                <ComboBoxItem Selected="EmotionHappy_Selected">Happy</ComboBoxItem>
                <ComboBoxItem Selected="EmotionNeutral_Selected">Neutral</ComboBoxItem>
                <ComboBoxItem Selected="EmotionCrazy_Selected">Crazy</ComboBoxItem>
                <ComboBoxItem Selected="EmotionSerious_Selected">Serious</ComboBoxItem>
                <ComboBoxItem Selected="EmotionEvil_Selected">Evil</ComboBoxItem>
                <ComboBoxItem Selected="EmotionHurt_Selected">Hurt</ComboBoxItem>
            </ComboBox>
        </StackPanel>
    </Grid>
</Window>
