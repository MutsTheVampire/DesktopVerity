<Window x:Class="DesktopVerity.IntroductionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:DesktopVerity"
        mc:Ignorable="d"
        Title="Introduction" Height="Auto" Width="300"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        SnapsToDevicePixels="True"
        Background="DarkGoldenrod"> <!-- Hardcoded background suggested by Kita -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="12,12,12,0">
            <Image Width="32" Height="32" x:Name="PartMessageIcon" Margin="0,0,6,0" />
            <TextBlock VerticalAlignment="Center">Introduce yourself to Verity.</TextBlock>
        </StackPanel>
        <Grid Grid.Row="1" Margin="12,6,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center">Your _name:</Label>
            <TextBox Grid.Column="1" x:Name="PartFriendName" TextChanged="PartFriendName_OnTextChanged" VerticalAlignment="Center"></TextBox>
        </Grid>
        <Grid Grid.Row="2" Background="#20000000" VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal" Margin="12" HorizontalAlignment="Right">
                <Button Click="QuitButton_OnClick" Width="60" Margin="0,0,6,0">_Quit</Button>
                <Button Click="OkButton_OnClick" x:Name="OkButton" Width="60">_OK</Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
